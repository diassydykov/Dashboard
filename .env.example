# Copy to .env.local for development. Never commit real secrets.

# Supabase project URL, e.g. https://xxxx.supabase.co
NEXT_PUBLIC_SUPABASE_URL="https://your-project.supabase.co"

# Supabase anon/public key (safe for the browser, still keep RLS on)
NEXT_PUBLIC_SUPABASE_ANON_KEY="your-anon-key"

# Prisma uses the pooled Postgres URL.
# Vercel + Supabase Marketplace also inject POSTGRES_PRISMA_URL — the app maps it automatically.
DATABASE_URL="postgresql://postgres.PROJECT:PASSWORD@HOST:6543/postgres?pgbouncer=true"

# Direct connection for migrations (Session mode, port 5432).
# On Vercel this is also provided as POSTGRES_URL_NON_POOLING.
DIRECT_URL="postgresql://postgres.PROJECT:PASSWORD@HOST:5432/postgres"

# Optional: used only by prisma/seed.ts to create demo Auth users.
SUPABASE_SERVICE_ROLE_KEY=""
